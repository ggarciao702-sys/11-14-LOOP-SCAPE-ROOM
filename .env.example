# Copia este archivo como ".env" y llena tus datos. NUNCA subas ".env" a internet.

PORT=3000

# Correo donde te llegan los datos de cada pedido y mensaje
MAIL_TO=ggarciao702@inemkennedy.edu.co

# Cuenta desde la que se ENVÍAN los avisos (puede ser un Gmail tuyo).
# En Gmail necesitas verificación en 2 pasos y crear una "contraseña de aplicación":
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=la_contraseña_de_aplicación

# Archivo de la base de datos (se crea solo)
DB_FILE=loop.db

# Contraseña del panel de administración (http://localhost:3000/admin.html).
# Elige una larga y difícil. Si la dejas vacía, el panel queda desactivado.
ADMIN_PASSWORD=cambia_esta_clave_larga
